# Copy to .env and replace placeholders before hosting. Never commit .env.

# Runtime paths and offline controls
COD_GUARD_DATA_DIR=./host-data
COD_GUARD_MODEL_PATH=./backend/app/model.pkl
COD_GUARD_OFFLINE=1
COD_GUARD_EXHIBITION=0
COD_GUARD_REPLY_RETENTION_DAYS=30

# Merchant mode (leave the database URL empty for the SQLite pilot).
# Use a dedicated unprivileged runtime login and a separate migration login.
COD_GUARD_DATABASE_URL=
COD_GUARD_MIGRATION_DATABASE_URL=
# See docs/MERCHANT_PLATFORM.md for the versioned AES-256 keyring format.
COD_GUARD_DATA_KEYS=
COD_GUARD_AUTH_KEY=
COD_GUARD_PORTAL_ORIGINS=
COD_GUARD_REDIS_URL=
# Externally reachable callback prefix, such as https://portal.example.com/api.
COD_GUARD_PUBLIC_API_BASE=
# Shopify application credentials. Store installation credentials live in PostgreSQL.
COD_GUARD_SHOPIFY_CLIENT_ID=
COD_GUARD_SHOPIFY_CLIENT_SECRET=
# Enable after verifying Meta and Twilio test accounts and callbacks.
COD_GUARD_LIVE_BUYER_CONTACT=0
COD_GUARD_SMTP_HOST=
COD_GUARD_SMTP_PORT=587
COD_GUARD_SMTP_FROM=
COD_GUARD_SMTP_USER=
COD_GUARD_SMTP_PASSWORD=

# Operator authentication (keys must be >= 24 characters and unique)
# Example: {"ops-1": {"tenant_id": "seller-a", "key": "replace-with-a-24plus-char-secret-key"}}
COD_GUARD_OPERATORS={}

# Storefront connectors (see docs/SHOPIFY.md and docs/WOOCOMMERCE.md)
COD_GUARD_SHOPIFY={}
COD_GUARD_WOOCOMMERCE={}
COD_GUARD_WOO_HEALTH_LOCAL=0

# WhatsApp Cloud API (see docs/WHATSAPP_CLOUD.md)
COD_GUARD_WHATSAPP={}

# Couriers and shadow experiments (see docs/COURIERS.md and docs/DISPATCH_ADVICE.md)
COD_GUARD_TCS={}
COD_GUARD_DISPATCH_EXPERIMENTS={}
COD_GUARD_RISK_SHADOW={}

# Opt-in cross-merchant reputation network (off by default; see docs/NETWORK.md)
COD_GUARD_NETWORK_KEY=
COD_GUARD_NETWORK_TENANTS={}

# Streamlit intake UI target API (https://... or loopback http://127.0.0.1:8000)
COD_GUARD_INTAKE_API=http://127.0.0.1:8000

# Offline Whisper cache and model selection (see docs/VOICE_ACCURACY.md)
COD_GUARD_WHISPER_MODEL=small
COD_GUARD_WHISPER_CACHE=./data/whisper
